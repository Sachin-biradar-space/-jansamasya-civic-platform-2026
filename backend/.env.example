# Backend Environment Variables Template for Localhost & Production (Render)

# Server Port (Render automatically assigns PORT in production; default 5000 for local)
PORT=5000

# Node Environment ('development' for local, 'production' on Render)
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/fixmytown?retryWrites=true&w=majority

# JWT Secret Key for token signing and authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client URL for CORS (set to your Vercel deployment URL in production)
CLIENT_URL=https://your-app.vercel.app

# Cloudinary Configuration for persistent image uploads (Required for production on Render)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
